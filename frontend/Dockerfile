FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_KEYCLOAK_URL
ARG NEXT_PUBLIC_LEGAL_CURRENT_VERSION
ARG NEXT_PUBLIC_USER_CREATION_APPROVAL_REQUIRED
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL
ENV NEXT_PUBLIC_LEGAL_CURRENT_VERSION=$NEXT_PUBLIC_LEGAL_CURRENT_VERSION
ENV NEXT_PUBLIC_USER_CREATION_APPROVAL_REQUIRED=$NEXT_PUBLIC_USER_CREATION_APPROVAL_REQUIRED
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "start"]
